# Campus Radar API Server Environment Configuration (Template)
NODE_ENV=production
API_PORT=5001

# Allowed Origins (CORS)
ALLOWED_ORIGINS=https://campusradar.sanjivani.edu.in,http://localhost:5173

# Database (PostgreSQL / Supabase Transaction & Session Pooler)
DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_MAX_CONNECTIONS=4
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=30000

# Supabase Storage & Public Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key

# Email OTP Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
OTP_SENDER_EMAIL=verify@sanjivani.edu.in
OTP_SALT=your-cryptographic-salt-change-in-production
OTP_EXPIRY_MINUTES=10

# SMS OTP Service (TextBee Gateway)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_device_id_here
